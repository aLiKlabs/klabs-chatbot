# Public URL for dashboard links and generated widget installation snippets.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public Supabase project URL and browser-safe anonymous key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATABASE_URL=

# Server-only OpenAI configuration used by later ingestion and chat phases.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_EMBEDDING_DIMENSIONS=1536
# Local workflow testing only. Never enable on a production deployment.
MOCK_EMBEDDINGS=false
# Optional USD rates per one million tokens for internal cost estimates.
OPENAI_INPUT_COST_PER_MILLION=0
OPENAI_OUTPUT_COST_PER_MILLION=0
OPENAI_EMBEDDING_COST_PER_MILLION=0

# Comma-separated K-Labs administrator email allowlist.
ADMIN_ALLOWED_EMAILS=

# Server-only job endpoint credentials.
CRON_SECRET=
INGESTION_SECRET=

# Optional production rate-limit provider configuration.
RATE_LIMIT_PROVIDER=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Retrieval defaults used by later chatbot phases.
DEFAULT_MAX_RETRIEVAL_RESULTS=6
DEFAULT_SIMILARITY_THRESHOLD=0.72
DEFAULT_MAX_CONTEXT_TOKENS=6000
DEFAULT_MAX_OUTPUT_TOKENS=600
