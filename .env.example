# Public URL for dashboard links and generated widget installation snippets.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Laravel API. The internal key must match backend/.env and must remain server-only.
LARAVEL_API_URL=http://127.0.0.1:8000
LARAVEL_INTERNAL_KEY=replace-with-at-least-32-random-characters

# Server-only OpenAI configuration used by later ingestion and chat phases.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
# Local workflow testing only. Never enable on a production deployment.
MOCK_EMBEDDINGS=false
# The analytics calculator uses the official GPT-5.6 Luna standard rates and
# text-embedding-3-small pricing. Update lib/openai/pricing.ts when changing models.

# Comma-separated K-Labs administrator email allowlist.
ADMIN_ALLOWED_EMAILS=

# Server-only job endpoint credentials.
CRON_SECRET=
INGESTION_SECRET=

# Optional production rate-limit provider configuration.
RATE_LIMIT_PROVIDER=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Retrieval defaults used by later chatbot phases.
DEFAULT_MAX_RETRIEVAL_RESULTS=3
DEFAULT_SIMILARITY_THRESHOLD=0.72
DEFAULT_MAX_CONTEXT_TOKENS=3000
DEFAULT_MAX_OUTPUT_TOKENS=220
